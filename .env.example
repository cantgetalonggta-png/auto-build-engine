# Auto-Build Engine / App Builder environment template
# Copy to .env.local for local use. Do not commit real secrets.
# On Vercel: Settings → Environment Variables
#   Config  = readable after save (non-sensitive)
#   Secret  = write-only after save (keys/tokens)
# Changes apply only to NEW deployments — redeploy after edits.

# --- Secret (server only) ---
XAI_API_KEY=

# --- Config ---
XAI_MODEL=grok-3-latest
XAI_BASE_URL=https://api.x.ai/v1
GROK_CHAT_ENABLED=true
VITE_AUTH_ENABLED=false

# Optional local CLI only (Secret). Prefer dashboard or connected Vercel.
# VERCEL_TOKEN=

# Set by App Builder on publish (Config)
# GROK_PROJECT_ID=
